APP_NAME="Sorteos CR"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sorteoscr.morpho3d.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CR

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=TU_BASE_DE_DATOS
DB_USERNAME=TU_USUARIO_DB
DB_PASSWORD=TU_PASSWORD_DB

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.morpho3d.com

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=TU_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=TU_SMTP_USER
MAIL_PASSWORD=TU_SMTP_PASSWORD
MAIL_FROM_ADDRESS=no-reply@sorteoscr.morpho3d.com
MAIL_FROM_NAME="Sorteos CR"

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAR_POR_UN_PASSWORD_LARGO_Y_SEGURO

VITE_APP_NAME="Sorteos CR"
