<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Bloquear acceso publico a carpetas internas de Laravel y archivos sensibles.
    RewriteRule ^laravel-app/(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L]
    RewriteRule ^laravel-app/(\.env|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|artisan|README\.md|DEPLOY_HOSTINGER\.md) - [F,L]
    RewriteRule (^|/)\\. - [F,L]
    RewriteRule ^legacy-static(/|$) - [F,L]

    # Servir assets compilados y storage publico de Laravel aunque el document root sea la raiz del repo.
    RewriteRule ^build/(.*)$ laravel-app/public/build/$1 [L]
    RewriteRule ^storage/(.*)$ laravel-app/public/storage/$1 [L]
    RewriteRule ^favicon\.ico$ laravel-app/public/favicon.ico [L]
    RewriteRule ^robots\.txt$ laravel-app/public/robots.txt [L]

    # Enviar el resto a Laravel.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

